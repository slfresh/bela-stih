{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 reports `baseUrl` as deprecated - and a config error stops
    // tsc before it checks a single file, while printing nothing else. For a
    // long time `tsc --noEmit` here "passed" by checking nothing at all.
    "ignoreDeprecations": "6.0",
    // The workspace packages, from source: node_modules links them to whichever
    // checkout ran npm install, which is not always this one (git worktrees).
    "baseUrl": ".",
    "paths": {
      "@belot/*": ["../../packages/*/src/index.ts"]
    }
  }
}
