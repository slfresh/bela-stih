# Caddy fronts everything on {$DOMAIN}: automatic Let's Encrypt TLS, the
# Colyseus game traffic proxied through, and the static privacy page for
# plain browsers. Colyseus needs three things forwarded: the HTTP matchmaking
# calls (/matchmake/*), the websocket upgrade (any path), and /health.
{$DOMAIN} {
	encode gzip

	# Cache policy. The web build content-hashes every asset filename, so those
	# URLs change whenever their bytes do and may be kept forever. The HTML entry
	# points must NOT be: the HTML is what names the current bundle hash, so a
	# cached copy pins a returning player to the build it shipped with.
	#
	# Nothing here sent Cache-Control at all before, which left browsers to guess
	# (heuristic freshness, about 10% of the file's age) and could go on serving
	# the previous build for hours after a deploy. ETags are already correct, so
	# no-cache costs a 304 and nothing more.
	@hashed path /igra/_expo/* /igra/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@unhashed not path /igra/_expo/* /igra/assets/*
	header @unhashed Cache-Control "no-cache"

	@game path /matchmake/* /health
	handle @game {
		reverse_proxy bela:2567
	}

	@ws {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @ws {
		reverse_proxy bela:2567
	}

	# Invite links: /join/CODE all render the same static page, which reads
	# the code from the URL and hands off to the app (or the Play listing).
	# An error must never inherit the immutable header above. A 404 for a hashed
	# asset would otherwise be pinned in the browser for a year, and "immutable"
	# suppresses even a reload's revalidation — that browser could never load the
	# app again. It is reachable, too: the deploy unpacks in place while Caddy is
	# still serving, so a player can ask for a bundle in the moment between the
	# new HTML landing and its script arriving.
	handle_errors {
		header Cache-Control "no-cache"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	# Bare /join as well as /join/CODE: the short form is the one people type.
	@join path /join /join/*
	handle @join {
		root * /srv/site
		rewrite * /join.html
		file_server
	}

	handle {
		root * /srv/site
		file_server
	}
}
